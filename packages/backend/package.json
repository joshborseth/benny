{
  "name": "@benny/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./convex/_generated/api.js",
    "./dataModel": "./convex/_generated/dataModel.d.ts",
    "./convex/*": "./convex/*"
  },
  "scripts": {
    "dev": "cd ../.. && convex dev",
    "setup": "cd ../.. && convex dev --once",
    "deploy": "cd ../.. && convex deploy",
    "codegen": "cd ../.. && convex codegen",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "convex": "^1.31.0"
  },
  "devDependencies": {
    "@benny/config": "workspace:*",
    "@types/node": "^26.1.1",
    "typescript": "^6"
  }
}
