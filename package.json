{
  "name": "benny",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "quality": "turbo run lint format",
    "quality:fix": "turbo run lint:fix format:fix",
    "typecheck": "turbo run typecheck",
    "setup": "turbo run setup --filter=@benny/backend"
  },
  "dependencies": {
    "convex": "^1.42.3"
  },
  "devDependencies": {
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.11"
}
