# Root env for the whole monorepo (copy to .env.local)
CONVEX_DEPLOYMENT=dev:your-deployment
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site

# Shared secret: worker auth + AES key for site credentials (min 16 chars).
# Also set these on the Convex deployment: `npx convex env set NAME value`
WORKER_SECRET=change-me-to-a-long-random-string
CREDENTIALS_ENCRYPTION_KEY=change-me-to-another-long-random-string

# AI browser worker (apps/worker) — OpenAI key for Stagehand LOCAL
OPENAI_API_KEY=
# Optional overrides:
# STAGEHAND_MODEL=openai/gpt-4o-mini  # default; use openai/gpt-4o if nav/extract quality drops
# STAGEHAND_MAX_PAGES=10
# STAGEHAND_EXTRACT_PASSES=5  # re-extract on same page until no new grounded rows (fixes partial lists)
# STAGEHAND_NAV_MAX_STEPS=6
# STAGEHAND_HEADLESS=false   # strongly recommended for sites that block bots (default is headless true)
# STAGEHAND_STEALTH=false    # default true: anti-detect launch flags + init script + non-Headless UA
# STAGEHAND_LOCALE=en-US
# STAGEHAND_VIEWPORT_WIDTH=1440
# STAGEHAND_VIEWPORT_HEIGHT=900
# STAGEHAND_USER_AGENT=Mozilla/5.0 (...)  # optional; when headless+stealth, HeadlessChrome UA is replaced
# STAGEHAND_PROXY_SERVER=http://host:port
# STAGEHAND_PROXY_BYPASS=localhost
# STAGEHAND_PROXY_USERNAME=
# STAGEHAND_PROXY_PASSWORD=
# STAGEHAND_CACHE_DIR=/path/to/stagehand-cache  # default: apps/worker/.stagehand-cache
# CHROME_PATH=/path/to/chrome # optional; else prefers system Chrome, then Playwright Chromium
# WORKER_POLL_MS=3000
# selfHeal is enabled in code (login/nav action cache repairs selectors on DOM drift)
