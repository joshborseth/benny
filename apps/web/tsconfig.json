{
  "extends": "@benny/config/typescript/react.json",
  "include": ["**/*.ts", "**/*.tsx", "vite.config.ts"],
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@benny/ui/*": ["../../packages/ui/src/*"],
      "@benny/backend/*": ["../../packages/backend/*"]
    },
    "allowImportingTsExtensions": true,
    "noUncheckedSideEffectImports": true
  }
}
